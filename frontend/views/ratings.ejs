<%- include('partials/base') %>
    <link rel="stylesheet" href="/css/ratings.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/7.2.3/css/flag-icons.min.css" />
    </head>

    <body>

        <%- include('partials/navbar') %>

            <div class="container" style="padding-top: 10px; padding-bottom: 40px;">

                <!-- Page Header -->
                <div class="rl-page-header">
                    <div>
                        <div class="rl-page-title">Rating Leaderboard</div>
                        <div class="rl-page-subtitle">Rankings across all competitive programming metrics</div>
                    </div>
                    <div id="rl-last-updated" style="font-size:11px;color:#bbb;"></div>
                </div>

                <!-- Tab Switcher -->
                <div class="rl-tabs">
                    <button class="rl-tab active" data-tab="problem" onclick="switchTab('problem')">Rating</button>
                    <button class="rl-tab" data-tab="contest" onclick="switchTab('contest')">Contest
                        Rating</button>
                    <button class="rl-tab" data-tab="global" onclick="switchTab('global')">Global Score</button>
                </div>

                <!-- Controls -->
                <div class="rl-controls">
                    <div class="rl-search-wrap">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.35-4.35" />
                        </svg>
                        <input type="text" class="rl-search" id="rl-search" placeholder="Search username…"
                            oninput="onSearch()" />
                    </div>
                    <select class="rl-country-select" id="rl-country" onchange="onCountryFilter()">
                        <option value="">All Countries</option>
                    </select>
                    <div class="rl-count" id="rl-count"></div>
                </div>

                <!-- Table -->
                <div class="rl-table-wrap">
                    <div class="rl-loading" id="rl-loading">Loading leaderboard…</div>
                    <table class="rl-table" id="rl-table" style="display:none;">
                        <thead id="rl-thead"></thead>
                        <tbody id="rl-tbody"></tbody>
                    </table>
                    <div class="rl-empty" id="rl-empty" style="display:none;">No users match your filters.</div>
                </div>

                <!-- Pagination -->
                <div class="rl-pagination" id="rl-pagination"></div>

            </div>


            <script>
                // ── Country → flag emoji ──
                const COUNTRY_FLAGS = {
