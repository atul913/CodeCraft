                    'Latvia': '<span class="fi fi-lv"></span>',
                    'Lebanon': '<span class="fi fi-lb"></span>',
                    'Lithuania': '<span class="fi fi-lt"></span>',
                    'Malaysia': '<span class="fi fi-my"></span>',
                    'Mexico': '<span class="fi fi-mx"></span>',
                    'Moldova': '<span class="fi fi-md"></span>',
                    'Mongolia': '<span class="fi fi-mn"></span>',
                    'Morocco': '<span class="fi fi-ma"></span>',
                    'Myanmar': '<span class="fi fi-mm"></span>',
                    'Nepal': '<span class="fi fi-np"></span>',
                    'Netherlands': '<span class="fi fi-nl"></span>',
                    'New Zealand': '<span class="fi fi-nz"></span>',
                    'Nigeria': '<span class="fi fi-ng"></span>',
                    'North Korea': '<span class="fi fi-kp"></span>',
                    'Norway': '<span class="fi fi-no"></span>',
                    'Pakistan': '<span class="fi fi-pk"></span>',
                    'Palestine': '<span class="fi fi-ps"></span>',
                    'Peru': '<span class="fi fi-pe"></span>',
                    'Philippines': '<span class="fi fi-ph"></span>',
                    'Poland': '<span class="fi fi-pl"></span>',
                    'Portugal': '<span class="fi fi-pt"></span>',
                    'Romania': '<span class="fi fi-ro"></span>',
                    'Russia': '<span class="fi fi-ru"></span>',
                    'Saudi Arabia': '<span class="fi fi-sa"></span>',
                    'Serbia': '<span class="fi fi-rs"></span>',
                    'Singapore': '<span class="fi fi-sg"></span>',
                    'Slovakia': '<span class="fi fi-sk"></span>',
                    'Slovenia': '<span class="fi fi-si"></span>',
                    'South Africa': '<span class="fi fi-za"></span>',
                    'South Korea': '<span class="fi fi-kr"></span>',
                    'Spain': '<span class="fi fi-es"></span>',
                    'Sri Lanka': '<span class="fi fi-lk"></span>',
                    'Sweden': '<span class="fi fi-se"></span>',
                    'Switzerland': '<span class="fi fi-ch"></span>',
                    'Syria': '<span class="fi fi-sy"></span>',
                    'Taiwan': '<span class="fi fi-tw"></span>',
                    'Tajikistan': '<span class="fi fi-tj"></span>',
                    'Thailand': '<span class="fi fi-th"></span>',
                    'Tunisia': '<span class="fi fi-tn"></span>',
                    'Turkey': '<span class="fi fi-tr"></span>',
                    'Turkmenistan': '<span class="fi fi-tm"></span>',
                    'Ukraine': '<span class="fi fi-ua"></span>',
                    'United Arab Emirates': '<span class="fi fi-ae"></span>',
                    'United Kingdom': '<span class="fi fi-gb"></span>',
                    'United States': '<span class="fi fi-us"></span>',
                    'Uruguay': '<span class="fi fi-uy"></span>',
                    'Uzbekistan': '<span class="fi fi-uz"></span>',
                    'Venezuela': '<span class="fi fi-ve"></span>',
                    'Vietnam': '<span class="fi fi-vn"></span>',
                    'Yemen': '<span class="fi fi-ye"></span>',
                    'Zimbabwe': '<span class="fi fi-zw"></span>'
                }
                const API = '/api'

                function getToken() { return localStorage.getItem('token') }
                function getLocalUser() { const d = localStorage.getItem('user'); return d ? JSON.parse(d) : null; }

                const loggedInUser = getLocalUser()

                // ── State ──
                let allUsers = []          // full fetched list
                let filtered = []          // after search + country filter
                let activeTab = 'contest'
                let sortCol = null        // column key
                let sortDir = 'desc'
                let currentPage = 1
                const PAGE_SIZE = 50



                function getFlag(country) {
                    if (!country) return ''
                    return COUNTRY_FLAGS[country] || '🏳'
                }

                function getFlagEmoji(country) {
                    if (!country) return '';
                    const html = COUNTRY_FLAGS[country];
                    if (!html) return '🏳';
                    const match = html.match(/fi-([a-z]{2})/);
                    if (!match) return '🏳';
                    const code = match[1].toUpperCase();
                    const codePoints = code.split('').map(char => 127397 + char.charCodeAt(0));
                    return String.fromCodePoint(...codePoints);
                }

                // ── Tab config ──
                const TABS = {
                    contest: {
                        label: 'Contest Rating',
                        sortKey: 'contestRating',
                        headers: ['', 'Who', '#', '='],
                        keys: [null, null, 'contestsPlayed', 'contestRating'],
                        render: renderContestRow
                    },
                    problem: {
                        label: 'Problem Rating',
                        sortKey: 'problemRating',
                        headers: ['', 'Who', '#', '='],
                        keys: [null, null, 'problemsSolved', 'problemRating'],
                        render: renderProblemRow
                    },
                    global: {
                        label: 'Global Score',
                        sortKey: 'globalScore',
                        headers: ['', 'Who', '#', '='],
                        keys: [null, null, 'reputation', 'globalScore'],
                        render: renderGlobalRow
                    }
                }

                // ── Fetch ──
                async function loadLeaderboard() {
                    try {
                        const res = await fetch(`${API}/leaderboard`)
                        const data = await res.json()
                        if (!data.success) throw new Error(data.message)

                        allUsers = data.data
                        buildCountryFilter()
                        applyFilters()
                        document.getElementById('rl-last-updated').textContent =
                            'Updated ' + new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })
                    } catch (e) {
                        document.getElementById('rl-loading').textContent = 'Failed to load leaderboard. ' + (e.message || '')
                    }
                }



                function buildCountryFilter() {
                    const countries = [...new Set(allUsers.map(u => u.country).filter(Boolean))].sort()
                    const sel = document.getElementById('rl-country')
                    sel.innerHTML = '<option value="">All Countries</option>'
                    countries.forEach(c => {
                        const opt = document.createElement('option')
                        opt.value = c
                        opt.textContent = `${getFlagEmoji(c)} ${c}`
                        sel.appendChild(opt)
                    })
                }

                // ── Filters + Sort ──
                function applyFilters() {
                    const query = document.getElementById('rl-search').value.trim().toLowerCase()
                    const country = document.getElementById('rl-country').value

                    const tab = TABS[activeTab]
                    const key = sortCol || tab.sortKey

                    filtered = allUsers
                        .filter(u => {
                            if (query && !u.username.toLowerCase().includes(query) &&
                                !(u.name || '').toLowerCase().includes(query)) return false
                            if (country && u.country !== country) return false
                            return true
                        })
                        .sort((a, b) => {
                            const av = a[key] ?? -1
                            const bv = b[key] ?? -1
                            if (typeof av === 'string') return sortDir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av)
                            return sortDir === 'asc' ? av - bv : bv - av
                        })

                    currentPage = 1
                    document.getElementById('rl-count').textContent =
                        filtered.length === allUsers.length
                            ? `${allUsers.length} users`
                            : `${filtered.length} of ${allUsers.length} users`

                    renderTable()
                }

                function onSearch() { applyFilters() }
                function onCountryFilter() { applyFilters() }

                function switchTab(tab) {
                    activeTab = tab
                    sortCol = null
                    sortDir = 'desc'
                    document.querySelectorAll('.rl-tab').forEach(el => {
                        el.classList.toggle('active', el.dataset.tab === tab)
                    })
                    applyFilters()
                }

                function sortBy(key) {
                    if (sortCol === key) {
                        sortDir = sortDir === 'desc' ? 'asc' : 'desc'
                    } else {
                        sortCol = key
                        sortDir = 'desc'
                    }
                    applyFilters()
                }

                // ── Render ──
                function renderTable() {
                    const tab = TABS[activeTab]
                    const thead = document.getElementById('rl-thead')
                    const tbody = document.getElementById('rl-tbody')
                    const table = document.getElementById('rl-table')
                    const empty = document.getElementById('rl-empty')
                    const loading = document.getElementById('rl-loading')

                    loading.style.display = 'none'

                    if (filtered.length === 0) {
                        table.style.display = 'none'
                        empty.style.display = 'block'
                        document.getElementById('rl-pagination').innerHTML = ''
                        return
                    }

                    table.style.display = 'table'
                    empty.style.display = 'none'

                    // Headers
                    const activeKey = sortCol || tab.sortKey
                    thead.innerHTML = '<tr>' + tab.headers.map((h, i) => {
                        const key = tab.keys[i]
                        const isNum = (h === '#' || h === '=')
                        const alignClass = isNum ? 'col-num' : ''
                        if (!key) return `<th class="no-sort ${alignClass}">${h}</th>`
                        const cls = key === activeKey ? (sortDir === 'asc' ? 'sorted-asc' : 'sorted-desc') : ''
                        return `<th class="${cls} ${alignClass}" onclick="sortBy('${key}')">${h}</th>`
                    }).join('') + '</tr>'

                    // Paginate
                    const start = (currentPage - 1) * PAGE_SIZE
                    const page = filtered.slice(start, start + PAGE_SIZE)

                    tbody.innerHTML = page.map((u, i) => {
                        const globalRank = start + i + 1
                        return tab.render(u, globalRank)
                    }).join('')

                    renderPagination()
                }

                function renderPagination() {
                    const total = Math.ceil(filtered.length / PAGE_SIZE)
                    const pg = document.getElementById('rl-pagination')
                    if (total <= 1) { pg.innerHTML = ''; return }

                    let html = ''
                    html += `<button class="pg-btn" onclick="goPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>‹</button>`

                    const pages = paginationRange(currentPage, total)
                    pages.forEach(p => {
                        if (p === '…') {
                            html += `<span class="pg-ellipsis">…</span>`
                        } else {
                            html += `<button class="pg-btn ${p === currentPage ? 'active' : ''}" onclick="goPage(${p})">${p}</button>`
                        }
                    })

                    html += `<button class="pg-btn" onclick="goPage(${currentPage + 1})" ${currentPage === total ? 'disabled' : ''}>›</button>`
                    pg.innerHTML = html
                }

                function paginationRange(cur, total) {
                    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)
                    const pages = [1]
                    if (cur > 3) pages.push('…')
                    for (let p = Math.max(2, cur - 1); p <= Math.min(total - 1, cur + 1); p++) pages.push(p)
                    if (cur < total - 2) pages.push('…')
                    pages.push(total)
                    return pages
                }

                function goPage(p) {
                    const total = Math.ceil(filtered.length / PAGE_SIZE)
                    if (p < 1 || p > total) return
                    currentPage = p
                    renderTable()
                    window.scrollTo({ top: 0, behavior: 'smooth' })
                }

                // ── Row Renderers ──
                function userCell(u) {
                    const isMe = loggedInUser && loggedInUser.username === u.username
                    const flag = getFlag(u.country)
                    const youBadge = isMe ? '<span class="you-badge">YOU</span>' : ''
                    const color = u.tier?.colorHex || '#1a1a1a'
                    
                    return `<td><div class="user-cell">
                        <span class="user-flag">${flag || '🏳'}</span>
                        <a href="/profile/${u.username}" class="user-link" style="color: ${color};">${u.username}</a>
                        ${youBadge}
                    </div></td>`
                }

                function rankCell(globalRank) {
                    return `<td class="rank-cell">${globalRank}</td>`
                }

                function renderContestRow(u, rank) {
                    const isMe = loggedInUser && loggedInUser.username === u.username
                    const rVal = u.isRated
                        ? `<span class="rating-val" style="color:${u.tier?.colorHex || '#1a1a1a'}">${u.contestRating}</span>`
                        : `<span class="rating-unrated">Unrated</span>`

                    return `<tr class="${isMe ? 'is-self' : ''}">
                        ${rankCell(rank)}
                        ${userCell(u)}
                        <td class="col-num">${u.contestsPlayed || 0}</td>
                        <td class="col-num">${rVal}</td>
                    </tr>`
                }

                function renderProblemRow(u, rank) {
                    const isMe = loggedInUser && loggedInUser.username === u.username
                    return `<tr class="${isMe ? 'is-self' : ''}">
                        ${rankCell(rank)}
                        ${userCell(u)}
                        <td class="col-num">${u.problemsSolved || 0}</td>
                        <td class="col-num"><span class="rating-val">${u.problemRating || 0}</span></td>
                    </tr>`
                }

                function renderGlobalRow(u, rank) {
                    const isMe = loggedInUser && loggedInUser.username === u.username
                    return `<tr class="${isMe ? 'is-self' : ''}">
                        ${rankCell(rank)}
                        ${userCell(u)}
                        <td class="col-num">${u.reputation || 0}</td>
                        <td class="col-num"><span class="rating-val" style="color:#3b5998">${u.globalScore || 0}</span></td>
                    </tr>`
                }

                function renderSolvedRow(u, rank) {
                    const isMe = loggedInUser && loggedInUser.username === u.username
                    return `<tr class="${isMe ? 'is-self' : ''}">
                        ${rankCell(rank)}
                        ${userCell(u)}
                        <td class="col-num">${u.problemsSolved || 0}</td>
                        <td class="col-num"><span class="rating-val">${u.problemsSolved || 0}</span></td>
                    </tr>`
                }

                // ── Boot ──
                document.addEventListener('DOMContentLoaded', loadLeaderboard)
            </script>

    </body>

    </html>