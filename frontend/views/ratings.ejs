                    'Austria': '<span class="fi fi-at"></span>',
                    'Azerbaijan': '<span class="fi fi-az"></span>',
                    'Bangladesh': '<span class="fi fi-bd"></span>',
                    'Belarus': '<span class="fi fi-by"></span>',
                    'Belgium': '<span class="fi fi-be"></span>',
                    'Bolivia': '<span class="fi fi-bo"></span>',
                    'Bosnia': '<span class="fi fi-ba"></span>',
                    'Brazil': '<span class="fi fi-br"></span>',
                    'Bulgaria': '<span class="fi fi-bg"></span>',
                    'Cambodia': '<span class="fi fi-kh"></span>',
                    'Canada': '<span class="fi fi-ca"></span>',
                    'Chile': '<span class="fi fi-cl"></span>',
                    'China': '<span class="fi fi-cn"></span>',
                    'Colombia': '<span class="fi fi-co"></span>',
                    'Croatia': '<span class="fi fi-hr"></span>',
                    'Cuba': '<span class="fi fi-cu"></span>',
                    'Czech Republic': '<span class="fi fi-cz"></span>',
                    'Denmark': '<span class="fi fi-dk"></span>',
                    'Ecuador': '<span class="fi fi-ec"></span>',
                    'Egypt': '<span class="fi fi-eg"></span>',
                    'Estonia': '<span class="fi fi-ee"></span>',
                    'Ethiopia': '<span class="fi fi-et"></span>',
                    'Finland': '<span class="fi fi-fi"></span>',
                    'France': '<span class="fi fi-fr"></span>',
                    'Georgia': '<span class="fi fi-ge"></span>',
                    'Germany': '<span class="fi fi-de"></span>',
                    'Ghana': '<span class="fi fi-gh"></span>',
                    'Greece': '<span class="fi fi-gr"></span>',
                    'Guatemala': '<span class="fi fi-gt"></span>',
                    'Hungary': '<span class="fi fi-hu"></span>',
                    'India': '<span class="fi fi-in"></span>',
                    'Indonesia': '<span class="fi fi-id"></span>',
                    'Iran': '<span class="fi fi-ir"></span>',
                    'Iraq': '<span class="fi fi-iq"></span>',
                    'Ireland': '<span class="fi fi-ie"></span>',
                    'Israel': '<span class="fi fi-il"></span>',
                    'Italy': '<span class="fi fi-it"></span>',
                    'Japan': '<span class="fi fi-jp"></span>',
                    'Jordan': '<span class="fi fi-jo"></span>',
                    'Kazakhstan': '<span class="fi fi-kz"></span>',
                    'Kenya': '<span class="fi fi-ke"></span>',
