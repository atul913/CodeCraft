<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - CodeCraft</title>
    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>

    <!-- Top Utilities Header -->
    <%- include('partials/navbar') %>

        <!-- Login Dashboard Layout -->
        <div class="container">

            <div class="welcome-banner">
                <h2>Fill in the form to login into CodeArena.</h2>
                <p>
                    You can use your <strong>handle</strong> or <strong>email</strong> to log in.
                    New to our community? <a href="/register">Register here</a> to start solving problems.
                </p>
            </div>

            <div class="grid-layout">

                <!-- Login Card -->
                <section class="card">
                    <div class="card-header">Login into CodeArena</div>
                    <div class="card-body">

                        <div id="alertsContainer"></div>

                        <form id="loginForm" onsubmit="return handleLoginSubmit(event)">
                            <div class="form-group">
                                <label class="form-label" for="handle">Handle / Email</label>
                                <div>
                                    <input type="text" id="handle" class="input-field"
                                        placeholder="e.g. coder123 or user@example.com" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="password">Password</label>
                                <div>
                                    <input type="password" id="password" class="input-field" placeholder="•••••••••" />
                                    <div class="input-subtext">Minimum 5 characters required.</div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div></div>
                                <div class="checkbox-container">
                                    <input type="checkbox" id="remember" />
                                    <label for="remember">Remember me for a month</label>
                                </div>
                            </div>

                            <div class="form-group">
                                <div></div>
                                <div class="form-action">
                                    <button type="submit" class="btn-submit" id="loginBtn">Login</button>
                                    <button type="button" class="forgot-link" onclick="toggleModal(true)">Forgot your
                                        password?</button>
                                </div>
                            </div>
                        </form>

                    </div>

                    <div class="social-auth-bar">
                        <span class="social-label">Or log in with:</span>
                        <div class="social-buttons">
                            <button class="btn-social btn-github">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                    <path
                                        d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                </svg>
                                <span>GitHub</span>
                            </button>
                            <button class="btn-social btn-email">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                    <path d="M22 6l-10 7L2 6" />
                                </svg>
                                <span>Email</span>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Sidebar -->
                <aside class="sidebar">
                    <h3>Login Guidelines</h3>
                    <p>Use your registered handle or email address to access your account and resume solving problems.
                    </p>
                    <div class="alert-box">
                        <strong>Remember:</strong> Do not share your password with anyone. Use a strong unique password
                        for your account.
                    </div>
                    <button class="sidebar-action-btn" onclick="window.location.href='/register'">Create A New
                        Account</button>
                </aside>

            </div>
        </div>

        <!-- Password Recovery Modal -->
        <div class="modal-overlay" id="recoveryModal">
            <div class="modal">
                <div class="modal-header">
                    <span>Password Recovery</span>
                    <button class="modal-close-btn" onclick="toggleModal(false)">&times;</button>
                </div>
                <div class="modal-body">
                    <p>Enter your registered handle or email. We will send password reset instructions to your inbox.
                    </p>
                    <div id="modalAlertsContainer"></div>
                    <div class="modal-form-group">
                        <label for="recoveryInput">Handle or Email</label>
                        <input type="text" id="recoveryInput" class="input-field" style="max-width:100%"
                            placeholder="e.g. coder123 or user@example.com" />
                    </div>
                    <div class="modal-actions">
                        <button class="btn-cancel" onclick="toggleModal(false)">Cancel</button>
                        <button class="btn-submit" onclick="handleRecovery()">Send Instructions</button>
                    </div>
                </div>
            </div>
        </div>


        <!-- Traditional Static Footer -->
        <footer>
            <div class="container">
                <p><a href="#">CodeCraft</a> &copy; Copyright 2010-2026 Mike Mirzayanov / CodeCraft Team</p>
                <p style="color:#aaa; margin-top:5px;">The only programming contests Web 2.0 platform</p>

                <p style="color: #3b5998; margin-top: 5px;">
                    <a href="#">Privacy Policy</a> | <a href="#">Terms and Conditions</a>
                </p>

                <div class="footer-sponsor-logo">C</div>
            </div>
        </footer>

        <script>
            const API = 'http://127.0.0.1:5000/api'

            // ── Clock ──
            function updateClock() {
                const now = new Date()
                const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
                const dd = String(now.getUTCDate()).padStart(2, '0')
                const mm = months[now.getUTCMonth()]
                const yy = now.getUTCFullYear()
                const hh = String(now.getUTCHours()).padStart(2, '0')
                const min = String(now.getUTCMinutes()).padStart(2, '0')
                const ss = String(now.getUTCSeconds()).padStart(2, '0')
                document.getElementById('serverTimeText').textContent = `${mm}/${dd}/${yy} ${hh}:${min}:${ss} UTC`
            }
            updateClock()
            setInterval(updateClock, 1000)

            // ── Modal ──
            function toggleModal(show) {
                const modal = document.getElementById('recoveryModal')
                document.getElementById('modalAlertsContainer').innerHTML = ''
                if (show) { modal.classList.add('active'); document.getElementById('recoveryInput').focus() }
                else modal.classList.remove('active')
            }

            // ── Alerts ──
            function showAlert(containerId, type, messages) {
                const el = document.getElementById(containerId)
                if (type === 'success') {
                    el.innerHTML = `<div class="alert-success">${messages}</div>`
                } else {
                    const items = Array.isArray(messages) ? messages.map(m => `<li>${m}</li>`).join('') : `<li>${messages}</li>`
                    el.innerHTML = `<div class="alert-danger"><strong>Error:</strong><ul>${items}</ul></div>`
                }
            }

            // ── Login ──
            async function handleLoginSubmit(event) {
                event.preventDefault()

                const handle = document.getElementById('handle').value.trim()
                const password = document.getElementById('password').value
                const alerts = document.getElementById('alertsContainer')
                alerts.innerHTML = ''

                const errors = []
                if (!handle) errors.push('Handle or email is required.')
                if (!password) errors.push('Password is required.')
                else if (password.length < 5) errors.push('Password must be at least 5 characters.')

                if (errors.length) { showAlert('alertsContainer', 'error', errors); return false }

                const btn = document.getElementById('loginBtn')
                btn.disabled = true
                btn.textContent = 'Logging in...'

                try {
                    const res = await fetch(`${API}/auth/login`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ handle, password })
                    })
                    const data = await res.json()

                    if (data.success) {
                        // save token
                        localStorage.setItem('token', data.token)
                        localStorage.setItem('user', JSON.stringify(data.user))

                        showAlert('alertsContainer', 'success', `Welcome back, <strong>${data.user.username}</strong>! Redirecting...`)
                        setTimeout(() => window.location.href = '/', 1500)
                    } else {
                        showAlert('alertsContainer', 'error', data.message || 'Login failed')
                    }
                } catch (e) {
                    showAlert('alertsContainer', 'error', 'Could not reach the server.')
                } finally {
                    btn.disabled = false
                    btn.textContent = 'Login'
                }

                return false
            }

            // ── Recovery (mock for now) ──
            function handleRecovery() {
                const input = document.getElementById('recoveryInput').value.trim()
                if (!input) {
                    document.getElementById('modalAlertsContainer').innerHTML =
                        '<div class="alert-danger">Please enter your handle or email.</div>'
                    return
                }
                document.getElementById('modalAlertsContainer').innerHTML =
                    `<div class="alert-success">Instructions sent to: <strong>${input}</strong></div>`
                setTimeout(() => toggleModal(false), 2500)
            }

            // ── If already logged in redirect ──
            if (localStorage.getItem('token')) window.location.href = '/'
        </script>
</body>

</html>