<%- include('partials/base') %>
    <script src="https://accounts.google.com/gsi/client" onload="initGoogleAuth()" async defer></script>
    </head>

    <body>

        <!-- Top Utilities Header -->
        <%- include('partials/navbar') %>

            <!-- Login Dashboard Layout -->
            <div class="container">

                <div class="welcome-banner">
                    <h2>Fill in the form to login into CodeCraft.</h2>
                    <p>
                        You can use your <strong>handle</strong> or <strong>email</strong> to log in.
                        New to our community? <a href="/register">Register here</a> to start solving problems.
                    </p>
                </div>

                <div class="grid-layout">

                    <!-- Login Card -->
                    <section class="card">
                        <div class="card-header">Login into CodeCraft</div>
                        <div class="card-body">

                            <div id="alertsContainer"></div>

                            <form id="loginForm" onsubmit="return handleLoginSubmit(event)">
                                <div class="form-group">
                                    <label class="form-label" for="handle">Handle / Email</label>
                                    <div>
                                        <input type="text" id="handle" class="input-field"
                                            placeholder="e.g. coder123 or user@example.com" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="password">Password</label>
                                    <div>
                                        <input type="password" id="password" class="input-field"
                                            placeholder="•••••••••" />
                                        <div class="input-subtext">Minimum 5 characters required.</div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div></div>
                                    <div class="checkbox-container">
                                        <input type="checkbox" id="remember" />
                                        <label for="remember">Remember me for a month</label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div></div>
                                    <div class="form-action">
                                        <button type="submit" class="btn-submit" id="loginBtn">Login</button>
                                        <button type="button" class="forgot-link" onclick="toggleModal(true)">Forgot
                                            your
                                            password?</button>
                                    </div>
                                </div>
                            </form>

                        </div>

                        <div class="social-auth-bar">
                            <span class="social-label">Or log in with:</span>
                            <div class="social-buttons">

                                <button type="button" class="btn-social btn-google" onclick="loginWithGoogle()">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path
                                            d="M12.24 10.285V13.4h6.887c-.275 1.565-1.88 4.604-6.887 4.604-4.33 0-7.866-3.577-7.866-8s3.536-8 7.866-8c2.46 0 4.105 1.025 5.047 1.926l2.427-2.334C17.955 2.192 15.34 1 12.24 1 6.033 1 1 6.033 1 12.24s5.033 11.24 11.24 11.24c6.478 0 10.793-4.537 10.793-10.986 0-.743-.08-1.3-.178-1.859H12.24z" />
                                    </svg>
                                    <span>Google</span>
                                </button>
                            </div>
                        </div>
                    </section>

                    <!-- Sidebar -->
                    <aside class="sidebar">
                        <h3>Login Guidelines</h3>
                        <p>Use your registered handle or email address to access your account and resume solving
                            problems.
                        </p>
                        <div class="alert-box">
                            <strong>Remember:</strong> Do not share your password with anyone. Use a strong unique
                            password
                            for your account.
                        </div>
                        <button class="sidebar-action-btn" onclick="window.location.href='/register'">Create A New
                            Account</button>
                    </aside>

                </div>
            </div>

            <!-- Password Recovery Modal -->
            <div class="modal-overlay" id="recoveryModal">
                <div class="modal">
                    <div class="modal-header">
                        <span>Password Recovery</span>
                        <button class="modal-close-btn" onclick="toggleModal(false)">&times;</button>
                    </div>
                    <div class="modal-body">
                        <p>Enter your registered handle or email. We will send password reset instructions to your
                            inbox.
                        </p>
                        <div id="modalAlertsContainer"></div>
                        <div class="modal-form-group">
                            <label for="recoveryInput">Handle or Email</label>
                            <input type="text" id="recoveryInput" class="input-field" style="max-width:100%"
                                placeholder="e.g. coder123 or user@example.com" />
                        </div>
                        <div class="modal-actions">
                            <button class="btn-cancel" onclick="toggleModal(false)">Cancel</button>
                            <button class="btn-submit" onclick="handleRecovery()">Send Instructions</button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Traditional Static Footer -->
            <footer>
                <div class="container">
                    <p><a href="#">CodeCraft</a> &copy; Copyright 2010-2026 Mike Mirzayanov / CodeCraft Team</p>
                    <p style="color:#aaa; margin-top:5px;">The only programming contests Web 2.0 platform</p>

                    <p style="color: #3b5998; margin-top: 5px;">
                        <a href="#">Privacy Policy</a> | <a href="#">Terms and Conditions</a>
                    </p>

                    <div class="footer-sponsor-logo">C</div>
                </div>
            </footer>

            <script>
                const API = '/api'
                const GOOGLE_CLIENT_ID = '<%= googleClientId %>'

                let tokenClient;
                function initGoogleAuth() {
                    if (!GOOGLE_CLIENT_ID) {
                        console.warn('Google Client ID is not configured.');
                        return;
                    }
                    try {
                        tokenClient = google.accounts.oauth2.initTokenClient({
                            client_id: GOOGLE_CLIENT_ID,
                            scope: 'openid email profile',
                            callback: async (tokenResponse) => {
                                if (tokenResponse && tokenResponse.access_token) {
                                    await handleGoogleAuth(tokenResponse.access_token);
                                }
                            },
                        });
                    } catch (err) {
                        console.error('Error initializing Google Auth Client:', err);
                    }
                }

                function loginWithGoogle() {
                    if (!GOOGLE_CLIENT_ID) {
                        alert('Google Login is not configured. Please set GOOGLE_CLIENT_ID in your environment.');
                        return;
                    }
                    if (tokenClient) {
                        tokenClient.requestAccessToken();
                    } else {
                        initGoogleAuth();
                        if (tokenClient) {
                            tokenClient.requestAccessToken();
                        } else {
                            alert('Failed to initialize Google Sign-In.');
                        }
                    }
                }

                async function handleGoogleAuth(accessToken) {
                    const alerts = document.getElementById('alertsContainer');
                    alerts.innerHTML = '';
                    const btn = document.querySelector('.btn-google');
                    const origText = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = 'Connecting...';

                    try {
                        const res = await fetch(`${API}/auth/google`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ accessToken })
                        });
                        const data = await res.json();

                        if (data.success) {
                            localStorage.setItem('token', data.token);
                            localStorage.setItem('refreshToken', data.refreshToken);
                            localStorage.setItem('user', JSON.stringify(data.user));
                            showAlert('alertsContainer', 'success', `Welcome, <strong>${data.user.username}</strong>! Redirecting...`);
                            setTimeout(() => window.location.href = '/problems', 1000);
                        } else {
                            showAlert('alertsContainer', 'error', data.message || 'Google authentication failed');
                        }
                    } catch (e) {
                        showAlert('alertsContainer', 'error', 'Could not reach the server.');
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = origText;
                    }
                }



                // ── Modal ──
                function toggleModal(show) {
                    const modal = document.getElementById('recoveryModal')
                    document.getElementById('modalAlertsContainer').innerHTML = ''
                    if (show) { modal.classList.add('active'); document.getElementById('recoveryInput').focus() }
                    else modal.classList.remove('active')
                }

                // ── Alerts ──
                function showAlert(containerId, type, messages) {
                    const el = document.getElementById(containerId)
                    if (type === 'success') {
                        el.innerHTML = `<div class="alert-success">${messages}</div>`
                    } else {
                        const items = Array.isArray(messages) ? messages.map(m => `<li>${m}</li>`).join('') : `<li>${messages}</li>`
                        el.innerHTML = `<div class="alert-danger"><strong>Error:</strong><ul>${items}</ul></div>`
                    }
                }

                // ── Login ──
                async function handleLoginSubmit(event) {
                    event.preventDefault()

                    const handle = document.getElementById('handle').value.trim()
                    const password = document.getElementById('password').value
                    const alerts = document.getElementById('alertsContainer')
                    alerts.innerHTML = ''

                    const errors = []
                    if (!handle) errors.push('Handle or email is required.')
                    if (!password) errors.push('Password is required.')
                    else if (password.length < 5) errors.push('Password must be at least 5 characters.')

                    if (errors.length) { showAlert('alertsContainer', 'error', errors); return false }

                    const btn = document.getElementById('loginBtn')
                    btn.disabled = true
                    btn.textContent = 'Logging in...'

                    try {
                        const res = await fetch(`${API}/auth/login`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ handle, password })
                        })
                        const data = await res.json()

                        if (data.success) {
                            // save token
                            localStorage.setItem('token', data.token)
                            localStorage.setItem('refreshToken', data.refreshToken)
                            localStorage.setItem('user', JSON.stringify(data.user))

                            showAlert('alertsContainer', 'success', `Welcome back, <strong>${data.user.username}</strong>! Redirecting...`)
                            setTimeout(() => window.location.href = '/problems', 100)
                        } else {
                            showAlert('alertsContainer', 'error', data.message || 'Login failed')
                        }
                    } catch (e) {
                        showAlert('alertsContainer', 'error', 'Could not reach the server.')
                    } finally {
                        btn.disabled = false
                        btn.textContent = 'Login'
                    }

                    return false
                }

                // ── Recovery (mock for now) ──
                function handleRecovery() {
                    const input = document.getElementById('recoveryInput').value.trim()
                    if (!input) {
                        document.getElementById('modalAlertsContainer').innerHTML =
                            '<div class="alert-danger">Please enter your handle or email.</div>'
                        return
                    }
                    document.getElementById('modalAlertsContainer').innerHTML =
                        `<div class="alert-success">Instructions sent to: <strong>${input}</strong></div>`
                    setTimeout(() => toggleModal(false), 2500)
                }

                // ── If already logged in redirect ──
                if (localStorage.getItem('token')) window.location.href = '/'
            </script>
    </body>

    </html>