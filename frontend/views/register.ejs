<%- include('partials/base') %>
    <script src="https://accounts.google.com/gsi/client" onload="initGoogleAuth()" async defer></script>
    </head>

    <body>

        <!-- Top Utilities Header -->
        <%- include('partials/navbar') %>

            <div class="container">

                <div class="welcome-banner">
                    <h2>Fill in the form to register in CodeCraft.</h2>
                    <p>
                        Create your handle and start solving problems, tracking your progress, and competing in
                        contests.
                        Already registered? <a href="/login">Login with your credentials</a>.
                    </p>
                </div>

                <div class="grid-layout">

                    <!-- Register Card -->
                    <section class="card">
                        <div class="card-header">Register in CodeCraft</div>
                        <div class="card-body">

                            <div id="alertsContainer"></div>

                            <form id="registerForm" onsubmit="return handleRegisterSubmit(event)">

                                <div class="form-group">
                                    <label class="form-label" for="reg-handle">Handle <span
                                            style="color:#c00">*</span></label>
                                    <div>
                                        <input type="text" id="reg-handle" class="input-field"
                                            placeholder="e.g. coder123" />
                                        <div class="input-subtext">Your username. Only letters, numbers, and
                                            underscores.
                                            3–20 characters.</div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="reg-email">Email <span
                                            style="color:#c00">*</span></label>
                                    <div>
                                        <input type="text" id="reg-email" class="input-field"
                                            placeholder="e.g. you@example.com" />
                                        <div class="input-subtext">A confirmation link will be sent to this address.
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="reg-password">Password <span
                                            style="color:#c00">*</span></label>
                                    <div>
                                        <input type="password" id="reg-password" class="input-field"
                                            placeholder="•••••••••" />
                                        <div class="input-subtext">At least 5 characters.</div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="reg-confirm">Confirm Password <span
                                            style="color:#c00">*</span></label>
                                    <div>
                                        <input type="password" id="reg-confirm" class="input-field"
                                            placeholder="•••••••••" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div></div>
                                    <div class="form-action">
                                        <button type="submit" class="btn-submit" id="registerBtn">Register</button>
                                        <a href="/login" class="cancel-link">Cancel and Login</a>
                                    </div>
                                </div>

                            </form>
                        </div>

                        <div class="social-auth-bar">
                            <span class="social-label">Or register instantly with:</span>
                            <div class="social-buttons">
                                <button type="button" class="btn-social btn-google" onclick="loginWithGoogle()">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <path
                                            d="M12.24 10.285V13.4h6.887c-.275 1.565-1.88 4.604-6.887 4.604-4.33 0-7.866-3.577-7.866-8s3.536-8 7.866-8c2.46 0 4.105 1.025 5.047 1.926l2.427-2.334C17.955 2.192 15.34 1 12.24 1 6.033 1 1 6.033 1 12.24s5.033 11.24 11.24 11.24c6.478 0 10.793-4.537 10.793-10.986 0-.743-.08-1.3-.178-1.859H12.24z" />
                                    </svg>
                                    <span>Google</span>
                                </button>
                            </div>
                        </div>
                    </section>

                    <!-- Sidebar -->
                    <aside class="sidebar">
                        <h3>Confirmations & Emails</h3>
                        <p>If you have registered but did not receive a verification email, do not create a duplicate
                            account.</p>
                        <p>Click <a href="#" onclick="alert('Demo: re-send link')">re-send verification link</a> or
                            check
                            your spam folder.</p>
                        <div class="alert-box">
                            <strong>Security Alert:</strong> Avoid obvious passwords. Never share your password or
                            recovery
                            details with anyone.
                        </div>
                    </aside>

                </div>
            </div>


            <!-- Traditional Static Footer -->
            <footer>
                <div class="container">
                    <p><a href="#">CodeCraft</a> &copy; Copyright 2010-2026 Mike Mirzayanov / CodeCraft Team</p>
                    <p style="color:#aaa; margin-top:5px;">The only programming contests Web 2.0 platform</p>

                    <p style="color: #3b5998; margin-top: 5px;">
                        <a href="#">Privacy Policy</a> | <a href="#">Terms and Conditions</a>
                    </p>

                    <div class="footer-sponsor-logo">C</div>
                </div>
            </footer>

            <script>
                const API = '/api'
                const GOOGLE_CLIENT_ID = '<%= googleClientId %>'

                let tokenClient;
                function initGoogleAuth() {
                    if (!GOOGLE_CLIENT_ID) {
                        console.warn('Google Client ID is not configured.');
                        return;
                    }
                    try {
                        tokenClient = google.accounts.oauth2.initTokenClient({
                            client_id: GOOGLE_CLIENT_ID,
                            scope: 'openid email profile',
                            callback: async (tokenResponse) => {
                                if (tokenResponse && tokenResponse.access_token) {
                                    await handleGoogleAuth(tokenResponse.access_token);
                                }
                            },
                        });
                    } catch (err) {
                        console.error('Error initializing Google Auth Client:', err);
                    }
                }

                function loginWithGoogle() {
                    if (!GOOGLE_CLIENT_ID) {
                        alert('Google Login is not configured. Please set GOOGLE_CLIENT_ID in your environment.');
                        return;
                    }
                    if (tokenClient) {
                        tokenClient.requestAccessToken();
                    } else {
                        initGoogleAuth();
                        if (tokenClient) {
                            tokenClient.requestAccessToken();
                        } else {
                            alert('Failed to initialize Google Sign-In.');
                        }
                    }
                }

                async function handleGoogleAuth(accessToken) {
                    const alerts = document.getElementById('alertsContainer');
                    alerts.innerHTML = '';
                    const btn = document.querySelector('.btn-google');
                    const origText = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = 'Connecting...';

                    try {
                        const res = await fetch(`${API}/auth/google`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ accessToken })
                        });
                        const data = await res.json();

                        if (data.success) {
                            localStorage.setItem('token', data.token);
                            localStorage.setItem('refreshToken', data.refreshToken);
                            localStorage.setItem('user', JSON.stringify(data.user));
                            showAlert('success', `Welcome, <strong>${data.user.username}</strong>! Redirecting...`);
                            setTimeout(() => window.location.href = '/problems', 1000);
                        } else {
                            showAlert('error', data.message || 'Google authentication failed');
                        }
                    } catch (e) {
                        showAlert('error', 'Could not reach the server.');
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = origText;
                    }
                }



                // ── Alerts ──
                function showAlert(type, messages) {
                    const el = document.getElementById('alertsContainer')
                    if (type === 'success') {
                        el.innerHTML = `<div class="alert-success">${messages}</div>`
                    } else {
                        const items = Array.isArray(messages) ? messages.map(m => `<li>${m}</li>`).join('') : `<li>${messages}</li>`
                        el.innerHTML = `<div class="alert-danger"><strong>Validation Failures:</strong><ul>${items}</ul></div>`
                    }
                }

                // ── Register ──
                async function handleRegisterSubmit(event) {
                    event.preventDefault()

                    const username = document.getElementById('reg-handle').value.trim()
                    const email = document.getElementById('reg-email').value.trim()
                    const password = document.getElementById('reg-password').value
                    const confirm = document.getElementById('reg-confirm').value

                    document.getElementById('alertsContainer').innerHTML = ''
                    const errors = []

                    if (!username) errors.push('Handle is required.')
                    else if (username.length < 3 || username.length > 20) errors.push('Handle must be 3–20 characters.')
                    else if (!/^[A-Za-z0-9_]+$/.test(username)) errors.push('Handle can only contain letters, numbers, and underscores.')

                    if (!email) errors.push('Email is required.')
                    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.push('Please enter a valid email.')

                    if (!password) errors.push('Password is required.')
                    else if (password.length < 5) errors.push('Password must be at least 5 characters.')

                    if (password !== confirm) errors.push('Passwords do not match.')

                    if (errors.length) { showAlert('error', errors); return false }

                    const btn = document.getElementById('registerBtn')
                    btn.disabled = true
                    btn.textContent = 'Registering...'

                    try {
                        const res = await fetch(`${API}/auth/register`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ username, email, password })
                        })
                        const data = await res.json()

                        if (data.success) {
                            showAlert('success', `Registration successful! Handle <strong>${username}</strong> is now registered. <a href="/login">Login here</a>.`)
                            document.getElementById('registerForm').reset()
                        } else {
                            showAlert('error', data.message || 'Registration failed')
                        }
                    } catch (e) {
                        showAlert('error', 'Could not reach the server.')
                    } finally {
                        btn.disabled = false
                        btn.textContent = 'Register'
                    }

                    return false
                }

                // ── If already logged in redirect ──
                if (localStorage.getItem('token')) window.location.href = '/'
            </script>
    </body>

    </html>