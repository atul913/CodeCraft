<%- include('partials/base') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/7.2.3/css/flag-icons.min.css" />
    <style>
        /* ---- PAGE-SPECIFIC HOMEPAGE STYLING ---- */
        /* ---- HERO ---- */
        .hero {
            padding: 100px 0 80px;
            text-align: center;
            animation: fadeIn 1s ease-out forwards;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--text-muted);
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 32px;
            padding: 6px 14px;
            border: 1px solid var(--border);
            border-radius: 100px;
            background: white;
        }

        .hero-badge .dot {
            width: 6px;
            height: 6px;
            background: #10b981;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .hero h1 {
            font-family: var(--font-serif);
            font-size: 76px;
            font-weight: 400;
            line-height: 1.05;
            margin-bottom: 24px;
            letter-spacing: -0.02em;
        }

        .hero h1 em {
            font-style: italic;
            color: var(--text-muted);
        }

        .hero p {
            font-size: 18px;
            color: var(--text-muted);
            max-width: 560px;
            margin: 0 auto 40px;
            font-weight: 300;
        }

        .hero-ctas {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* ---- FEATURES STRIP ---- */
        .features-strip {
            padding: 30px 0;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            overflow: hidden;
        }

        .strip-track {
            display: flex;
            gap: 60px;
            align-items: center;
            font-family: var(--font-mono);
            font-size: 12px;
            color: var(--text-muted);
            white-space: nowrap;
            animation: scroll-strip 25s linear infinite;
        }

        .strip-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .strip-dot {
            width: 4px;
            height: 4px;
            background: var(--premium);
            border-radius: 50%;
        }

        @keyframes scroll-strip {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }

        /* ---- SECTIONS ---- */
        .section {
            padding: 80px 0;
            border-top: 1px solid var(--border);
            position: relative;
        }

        .section-head {
            margin-bottom: 40px;
        }

        .section-head h2 {
            font-family: var(--font-serif);
            font-size: 42px;
            font-weight: 400;
        }

        .mono-badge {
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            display: block;
            margin-bottom: 12px;
        }

        /* ---- SPLIT PAGE LAYOUT ---- */
        .page-split {
            display: grid;
            grid-template-columns: 1.8fr 1fr;
            gap: 60px;
            margin-top: 20px;
            margin-bottom: 80px;
        }

        .left-col {
            display: flex;
            flex-direction: column;
        }

        .sidebar-col {
            display: flex;
            flex-direction: column;
            border-left: 1px solid var(--border);
            padding-left: 40px;
        }

        @media (max-width: 900px) {
            .page-split {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .sidebar-col {
                border-left: none;
                padding-left: 0;
                border-top: 1px solid var(--border);
                padding-top: 40px;
            }
        }

        /* ---- BENTO LAYOUT (REPLACED CARDS) ---- */
        .bento-showcase {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 20px;
            margin-top: 24px;
        }

        .bento-item {
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(229, 229, 226, 0.6);
            border-radius: 16px;
            padding: 36px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .bento-item:hover {
            transform: translateY(-2px);
            background: white;
            border-color: var(--premium);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.02);
        }

        .bento-wide {
            grid-column: span 2;
        }

        .bento-icon {
            font-size: 24px;
            margin-bottom: 16px;
            display: inline-block;
            width: 40px;
            height: 40px;
            background: var(--bg-subtle);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bento-item h3 {
            font-size: 18px;
            font-weight: 500;
            color: var(--text);
            margin-bottom: 8px;
        }

        .bento-item p {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Embedded Bento Visuals */
        .bento-preview {
            margin-top: 20px;
            background: var(--bg-subtle);
            border-radius: 10px;
            padding: 16px;
            border: 1px dashed var(--border);
        }

        .preview-nodes {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .preview-node {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--border);
            position: relative;
        }

        .preview-node.active {
            background: var(--premium);
            box-shadow: 0 0 0 4px var(--premium-light);
        }

        .preview-line {
            height: 1px;
            background: var(--border);
            flex-grow: 1;
        }

        .preview-collaborators {
            display: flex;
            align-items: center;
            gap: -8px;
        }

        .collab-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--text);
            color: white;
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            font-family: var(--font-mono);
            margin-right: -8px;
        }

        @media (max-width: 768px) {
            .bento-showcase {
                grid-template-columns: 1fr;
            }

            .bento-wide {
                grid-column: span 1;
            }
        }

        /* ---- SANDBOX SECTION ---- */
        .playground-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

        @media (max-width: 768px) {
            .playground-split {
                grid-template-columns: 1fr;
                gap: 30px;
            }
        }

        .code-area {
            background: white;
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);
        }

        .code-top {
            padding: 12px 20px;
            background: var(--bg-subtle);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: var(--text-muted);
            font-family: var(--font-mono);
        }

        .code-top-dots {
            display: flex;
            gap: 6px;
        }

        .dot-r {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ff5f57;
        }

        .dot-y {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ffbd2e;
        }

        .dot-g {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #28c940;
        }

        .code-input {
            width: 100%;
            height: 220px;
            border: none;
            padding: 20px;
            font-family: var(--font-mono);
            font-size: 13px;
            resize: none;
            outline: none;
            background: white;
            color: var(--text);
            line-height: 1.8;
        }

        .code-run {
            padding: 12px 20px;
            border-top: 1px solid var(--border);
            background: var(--bg-subtle);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .run-btn {
            background: var(--text);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 6px;
            font-family: var(--font-mono);
            font-size: 12px;
            cursor: pointer;
            transition: var(--transition);
        }

        .run-btn:hover {
            background: var(--premium);
        }

        .sandbox-text h2 {
            font-family: var(--font-serif);
            font-size: 42px;
            margin-bottom: 20px;
            font-weight: 400;
        }

        .sandbox-text p {
            color: var(--text-muted);
            margin-bottom: 30px;
            font-weight: 300;
        }

        .sandbox-ctas {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* ---- GLASS SIDEBAR FEED MODULES (REPLACED PANEL CARDS) ---- */
        .glass-widget {
            margin-bottom: 40px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .glass-widget:last-child {
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }

        .widget-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .widget-ttl {
            font-weight: 500;
            color: var(--text);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .widget-all {
            font-size: 12px;
            color: var(--premium);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
        }

        .widget-all:hover {
            color: #e8920f;
        }


        /* Top Rated Leaderboard */
        .rated-row {
            display: flex;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px dashed var(--border);
        }

        .rated-row:last-child {
            border-bottom: none;
        }

        .rated-rank {
            font-family: var(--font-mono);
            width: 24px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .rated-flag {
            margin-right: 8px;
            font-size: 14px;
        }

        .rated-name {
            font-size: 14px;
            text-decoration: none;
            flex-grow: 1;
            font-weight: 400;
            transition: var(--transition);
        }

        .rated-score {
            font-family: var(--font-mono);
            font-size: 13px;
            font-weight: 500;
        }

        /* Recent Activity */
        .activity-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px dashed var(--border);
            font-size: 13px;
        }

        .activity-row:last-child {
            border-bottom: none;
        }

        .a-user {
            font-weight: 500;
            text-decoration: none;
            width: 30%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: var(--transition);
        }

        .a-prob {
            color: var(--text-muted);
            text-decoration: none;
            width: 40%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: var(--transition);
        }

        .a-prob:hover,
        .a-user:hover {
            color: var(--premium);
        }

        .a-verdict {
            font-weight: 500;
            margin-right: 6px;
        }

        .v-ac {
            color: #059669;
        }

        .v-wa {
            color: #dc2626;
        }

        .v-ot {
            color: var(--text-muted);
        }

        .a-lang {
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--text-muted);
            background: var(--bg-subtle);
            padding: 2px 6px;
            border-radius: 4px;
        }

        .msg-empty,
        .msg-err {
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
            padding: 12px 0;
        }

        /* ---- BUTTONS & UTILITIES ---- */
        .btn {
            color: var(--premium);
            background-color: transparent;
            font-family: var(--font-main);
            font-size: 15px;
            font-weight: 400;
            padding: 8px 0;
            border-radius: var(--radius);
            cursor: pointer;
            transition: var(--transition);
            border: 1px solid transparent;
            text-decoration: none;
            display: inline-block;
        }

        .btn-filled {
            background: var(--text);
            color: var(--bg);
            padding: 10px 24px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            font-family: var(--font-main);
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            display: inline-block;
        }

        .btn-filled:hover {
            background: #333;
            transform: translateY(-1px);
        }

        .btn-outline {
            background: transparent;
            color: var(--text);
            padding: 10px 24px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 14px;
            font-family: var(--font-main);
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            display: inline-block;
        }

        .btn-outline:hover {
            border-color: var(--text);
            background: var(--bg-subtle);
        }

        /* ---- BACKGROUND ---- */
        .bg-blobs {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
            pointer-events: none;
        }

        .blob {
            position: absolute;
            background: var(--bg-subtle);
            filter: blur(8px);
        }

        .blob-1 {
            border-radius: 50%;
            width: 3000px;
            height: 2000px;
            bottom: 58%;
            left: -30%;
        }

        /* ---- ANIMATIONS ---- */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            }

            70% {
                transform: scale(1);
                box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
            }

            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }
    </style>
    </head>

    <body>
        <div class="bg-blobs">
            <div class="blob blob-1"></div>
        </div>

        <%- include('partials/navbar') %>

            <!-- HERO -->
            <header class="hero container">
                <div class="hero-badge">
                    <div class="dot"></div>
                    Structured Learning & Growth
                </div>
                <h1>Mastery through<br><em>deliberate practice.</em></h1>
                <p>A calm, focused workspace for students to refine algorithmic thinking, study core patterns, and learn
                    at their own pace.</p>

                <div class="hero-ctas">
                    <a href="/problems" class="btn-filled">Start Solving — Free ↗</a>
                    <a href="#editor" class="btn-outline">Free Compiler</a>
                </div>
            </header>

            <!-- STRIP -->
            <div class="features-strip">
                <div class="strip-track" id="stripTrack">
                    <span class="strip-item"><span class="strip-dot"></span>Binary Search</span>
                    <span class="strip-item"><span class="strip-dot"></span>Sliding Window</span>
                    <span class="strip-item"><span class="strip-dot"></span>Dynamic Programming</span>
                    <span class="strip-item"><span class="strip-dot"></span>Graph Traversal</span>
                    <span class="strip-item"><span class="strip-dot"></span>Two Pointers</span>
                    <span class="strip-item"><span class="strip-dot"></span>Backtracking</span>
                    <span class="strip-item"><span class="strip-dot"></span>Heaps & Priority Queues</span>
                    <span class="strip-item"><span class="strip-dot"></span>Tries</span>
                    <span class="strip-item"><span class="strip-dot"></span>Union Find</span>
                    <span class="strip-item"><span class="strip-dot"></span>Monotonic Stack</span>
                    <!-- Duplicate for infinite loop -->
                    <span class="strip-item"><span class="strip-dot"></span>Binary Search</span>
                    <span class="strip-item"><span class="strip-dot"></span>Sliding Window</span>
                    <span class="strip-item"><span class="strip-dot"></span>Dynamic Programming</span>
                    <span class="strip-item"><span class="strip-dot"></span>Graph Traversal</span>
                    <span class="strip-item"><span class="strip-dot"></span>Two Pointers</span>
                    <span class="strip-item"><span class="strip-dot"></span>Backtracking</span>
                    <span class="strip-item"><span class="strip-dot"></span>Heaps & Priority Queues</span>
                    <span class="strip-item"><span class="strip-dot"></span>Tries</span>
                    <span class="strip-item"><span class="strip-dot"></span>Union Find</span>
                    <span class="strip-item"><span class="strip-dot"></span>Monotonic Stack</span>
                </div>
            </div>

            <!-- MAIN BODY SPLIT -->
            <div class="container page-split">

                <!-- LEFT COLUMN: Learning & Features -->
                <div class="left-col">
                    <!-- BENTO SHOWCASE (REPLACED FEATURE CARDS) -->
                    <section class="section" style="padding-top: 0; border-top: none;">
                        <div class="section-head">
                            <span class="mono-badge">Platform Highlights</span>
                            <h2>A Better Way to Learn</h2>
                            <p style="color:var(--text-muted); font-weight:300; margin-top:8px;">Everything you need to
                                master algorithms and code cleanly, built for students.</p>
                        </div>

                        <div class="bento-showcase">
                            <!-- Bento item 1 (Wide): Structured Learning Path -->
                            <div class="bento-item bento-wide">
                                <div>
                                    <h3>Structured Learning Paths</h3>
                                    <p>Master problems sorted by fundamental algorithmic patterns rather than random
                                        grinding. Move step-by-step from Linear structures to dynamic optimizations.</p>
                                </div>
                                <div class="bento-preview">
                                    <div class="preview-nodes">
                                        <div class="preview-node active"></div>
                                        <div class="preview-line"></div>
                                        <div class="preview-node active"></div>
                                        <div class="preview-line"></div>
                                        <div class="preview-node"></div>
                                    </div>
                                    <div
                                        style="display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:11px; color:var(--text-muted); margin-top:8px;">
                                        <span>Linear Structures</span>
                                        <span>Non-Linear Mastery</span>
                                        <span>Optimization Paths</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Bento item 2: Practice Contests -->
                            <div class="bento-item">
                                <div>
                                    <h3>Practice Contests</h3>
                                    <p>Test your knowledge under friendly tournament conditions with zero-stress rating
                                        reviews.</p>
                                </div>
                            </div>

                            <!-- Bento item 3: AI Code Assistant -->
                            <div class="bento-item">
                                <div>
                                    <h3>AI Code Assistant</h3>
                                    <p>Receive deeply personalized explanations and debugging guidance for every failing
                                        test case on the fly.</p>
                                </div>
                            </div>

                            <!-- Bento item 4 (Wide): Realtime Collaborative Space -->
                            <div class="bento-item bento-wide">
                                <div>
                                    <h3>Collaborative Workspace</h3>
                                    <p>Pair program or brainstorm solutions in real-time with peer learners and study
                                        partners inside a shared synced environment.</p>
                                </div>
                                <div class="bento-preview"
                                    style="display:flex; justify-content:space-between; align-items:center;">
