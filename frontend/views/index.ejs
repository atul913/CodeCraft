                                        <div class="collab-avatar" style="background:#fea116;">+2</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>

                <!-- RIGHT COLUMN: Dynamic Feeds (Sidebar) -->
                <aside class="sidebar-col">

                    <!-- TOP RATED -->
                    <div class="glass-widget">
                        <div class="widget-head">
                            <span class="widget-ttl">Top rated</span>
                            <a href="/ratings" class="widget-all">All →</a>
                        </div>
                        <div id="top-rated-list">
                            <p class="msg-empty">Loading leaderboard…</p>
                        </div>
                    </div>


                </aside>
            </div>

            <!-- PLAYGROUND COMPILER -->
            <section id="editor" class="section">
                <div class="container">
                    <div class="playground-split">
                        <div class="sandbox-text">
                            <span class="mono-badge">Sandbox Playground</span>
                            <h2>Write code.<br>See it run.</h2>
                            <p>An ephemeral code execution environment. Perfect for testing simple functions
                                quickly. Supports Python, JavaScript, Go, Java, and C++.</p>
                            <div class="sandbox-ctas">
                                <a href="/sandbox" class="btn-filled">Launch Sandbox ↗</a>
                                <a href="javascript:void(0)" onclick="openSandboxModal()" class="btn-outline">Compiler
                                    Notice</a>
                            </div>
                        </div>
                        <div class="code-area">
                            <div class="code-top">
                                <div class="code-top-dots">
                                    <div class="dot-r"></div>
                                    <div class="dot-y"></div>
                                    <div class="dot-g"></div>
                                </div>
                                <span>sandbox.js — v8 Engine</span>
                            </div>
                            <textarea class="code-input" spellcheck="false" readonly>// Two Sum — solve it here, no login needed
function twoSum(nums, target) {
    const map = new Map();
    for (let i = 0; i < nums.length; i++) {
        const comp = target - nums[i];
        if (map.has(comp)) return [map.get(comp), i];
        map.set(nums[i], i);
    }
}
console.log(twoSum([2, 7, 11, 15], 9)); // [0, 1]</textarea>
                            <div class="code-run">
                                <span style="font-family:var(--font-mono); font-size:11px; color:var(--text-muted);"
                                    id="run-output">▸ Output: [0, 1]</span>
                                <button class="run-btn" id="runSimBtn">Run ↗</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SANDBOX INFO MODAL POP-UP -->
            <div class="modal-overlay" id="sandboxInfoModal"
                style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.4); backdrop-filter:blur(4px); z-index:9999; justify-content:center; align-items:center;">
                <div
                    style="background:white; border:1px solid var(--border); border-radius:16px; max-width:480px; padding:32px; box-shadow:0 30px 60px rgba(0,0,0,0.1); text-align:center; position:relative; margin: 20px;">
                    <button onclick="closeSandboxModal()"
                        style="position:absolute; top:16px; right:16px; background:none; border:none; font-size:24px; cursor:pointer; color:var(--text-muted);">&times;</button>

                    <h3
                        style="font-family:var(--font-serif); font-size:24px; font-weight:400; margin-bottom:12px; color:var(--text);">
                        Free Sandbox Compiler</h3>
                    <p style="color:var(--text-muted); font-size:14px; line-height:1.6; margin-bottom:24px;">The sandbox
                        compiler is a free-to-use, login-free development space. No accounts required, no limits. It is
                        a quick facility provided to help you test snippets, practice syntax, and debug code on the fly!
                    </p>
                    <button onclick="closeSandboxModal()" class="btn-filled" style="width:100%;">Got it,
                        thanks!</button>
                </div>
            </div>

            <!-- FOOTER -->
            <footer
                style="padding: 80px 0 60px; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 14px; background: white; width: 100%;">
                <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 40px;">
                    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 60px;"
                        class="footer-grid">
                        <div>
                            <span
                                style="font-family: var(--font-serif); font-size: 22px; font-style: italic; color: var(--text); margin-bottom: 12px; display: block;">CodeCraft</span>
                            <p style="font-size: 13px;">Crafting a more focused, calm way for students to learn computer
                                science.</p>
                        </div>
                        <div class="footer-col">
                            <h4
                                style="color: var(--text); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;">
                                Platform</h4>
                            <a href="/problems"
                                style="display: block; text-decoration: none; color: var(--text-muted); margin-bottom: 10px; font-size: 13px; transition: var(--transition);">Problems</a>
                            <a href="/ratings"
                                style="display: block; text-decoration: none; color: var(--text-muted); margin-bottom: 10px; font-size: 13px; transition: var(--transition);">Ratings</a>
                            <a href="/#editor"
                                style="display: block; text-decoration: none; color: var(--text-muted); margin-bottom: 10px; font-size: 13px; transition: var(--transition);">Sandbox</a>
                        </div>
                        <div class="footer-col">
                            <h4
                                style="color: var(--text); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;">
                                Community</h4>
                            <a href="/ratings"
                                style="display: block; text-decoration: none; color: var(--text-muted); margin-bottom: 10px; font-size: 13px; transition: var(--transition);">Leaderboard</a>
                            <a href="/login"
                                style="display: block; text-decoration: none; color: var(--text-muted); margin-bottom: 10px; font-size: 13px; transition: var(--transition);">Sign
                                In</a>
                        </div>
                        <div class="footer-col">
                            <h4
                                style="color: var(--text); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;">
                                About</h4>
                            <a href="#"
                                style="display: block; text-decoration: none; color: var(--text-muted); margin-bottom: 10px; font-size: 13px; transition: var(--transition);">Principles</a>
                            <a href="#"
                                style="display: block; text-decoration: none; color: var(--text-muted); margin-bottom: 10px; font-size: 13px; transition: var(--transition);">Privacy</a>
                        </div>
                    </div>
                    <div
                        style="padding-top: 40px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; font-size: 12px;">
                        <span>&copy; 2026 CodeCraft.</span>
                        <span>Optimized for student learning.</span>
                    </div>
                </div>
            </footer>

            <script>
                const API_BASE = window.location.origin + '/api';

                const COUNTRY_FLAGS = {
                    'Afghanistan': '🇦🇫', 'Albania': '🇦🇱', 'Algeria': '🇩🇿', 'Argentina': '🇦🇷', 'Armenia': '🇦🇲',
                    'Australia': '🇦🇺', 'Austria': '🇦🇹', 'Azerbaijan': '🇦🇿', 'Bangladesh': '🇧🇩', 'Belarus': '🇧🇾',
                    'Belgium': '🇧🇪', 'Bolivia': '🇧🇴', 'Bosnia': '🇧🇦', 'Brazil': '🇧🇷', 'Bulgaria': '🇧🇬',
                    'Cambodia': '🇰🇭', 'Canada': '🇨🇦', 'Chile': '🇨🇱', 'China': '🇨🇳', 'Colombia': '🇨🇴',
                    'Croatia': '🇭🇷', 'Cuba': '🇨🇺', 'Czech Republic': '🇨🇿', 'Denmark': '🇩🇰', 'Ecuador': '🇪🇨',
                    'Egypt': '🇪🇬', 'Estonia': '🇪🇪', 'Ethiopia': '🇪🇹', 'Finland': '🇫🇮', 'France': '🇫🇷',
                    'Georgia': '🇬🇪', 'Germany': '🇩🇪', 'Ghana': '🇬🇭', 'Greece': '🇬🇷', 'Guatemala': '🇬🇹',
                    'Hungary': '🇭🇺', 'India': '🇮🇳', 'Indonesia': '🇮🇩', 'Iran': '🇮🇷', 'Iraq': '🇮🇶',
                    'Ireland': '🇮🇪', 'Israel': '🇮🇱', 'Italy': '🇮🇹', 'Japan': '🇯🇵', 'Jordan': '🇯🇴',
                    'Kazakhstan': '🇰🇿', 'Kenya': '🇰🇪', 'Kosovo': '🇽🇰', 'Latvia': '🇱🇻', 'Lebanon': '🇱🇧',
                    'Lithuania': '🇱🇹', 'Malaysia': '🇲🇾', 'Mexico': '🇲🇽', 'Moldova': '🇲🇩', 'Mongolia': '🇲🇳',
                    'Morocco': '🇲🇦', 'Myanmar': '🇲🇲', 'Nepal': '🇳🇵', 'Netherlands': '🇳🇱', 'New Zealand': '🇳🇿',
                    'Nigeria': '🇳🇬', 'Norway': '🇳🇴', 'Pakistan': '🇵🇰', 'Palestine': '🇵🇸', 'Peru': '🇵🇪',
                    'Philippines': '🇵🇭', 'Poland': '🇵🇱', 'Portugal': '🇵🇹', 'Romania': '🇷🇴', 'Russia': '🇷🇺',
                    'Saudi Arabia': '🇸🇦', 'Serbia': '🇷🇸', 'Singapore': '🇸🇬', 'Slovakia': '🇸🇰', 'Slovenia': '🇸🇮',
                    'South Africa': '🇿🇦', 'South Korea': '🇰🇷', 'Spain': '🇪🇸', 'Sri Lanka': '🇱🇰', 'Sweden': '🇸🇪',
                    'Switzerland': '🇨🇭', 'Syria': '🇸🇾', 'Taiwan': '🇹🇼', 'Tajikistan': '🇹🇯', 'Thailand': '🇹🇭',
                    'Tunisia': '🇹🇳', 'Turkey': '🇹🇷', 'Turkmenistan': '🇹🇲', 'Ukraine': '🇺🇦',
                    'United Arab Emirates': '🇦🇪', 'United Kingdom': '🇬🇧', 'United States': '🇺🇸', 'Uruguay': '🇺🇾',
                    'Uzbekistan': '🇺🇿', 'Venezuela': '🇻🇪', 'Vietnam': '🇻🇳', 'Yemen': '🇾🇪', 'Zimbabwe': '🇿🇼'
                };

                function flag(c) { return COUNTRY_FLAGS[c] || ''; }
                function trunc(s, n) { return s && s.length > n ? s.slice(0, n - 2) + '…' : s; }


                async function fetchTopRated() {
                    try {
                        const r = await fetch(`${API_BASE}/leaderboard`);
                        const d = await r.json();
                        if (!d.success) throw new Error();
                        const top = d.data.slice(0, 10);
                        const el = document.getElementById('top-rated-list');
                        if (!top.length) { el.innerHTML = '<p class="msg-empty">No rated users yet.</p>'; return; }
                        el.innerHTML = top.map((u, i) => {
                            const color = u.tier?.colorHex || 'var(--text)';
                            return `<div class="rated-row">
                        <span class="rated-rank">${i + 1}</span>
                        <span class="rated-flag">${flag(u.country)}</span>
                        <a href="/profile/${u.username}" class="rated-name" style="color:${color}">${u.username}</a>
                        <span class="rated-score" style="color:${color}">${u.contestRating}</span>
                    </div>`;
                        }).join('');
                    } catch {
                        document.getElementById('top-rated-list').innerHTML = '<p class="msg-err">Failed to load</p>';
                    }
                }

                async function fetchActivities() {
                    try {
                        const r = await fetch(`${API_BASE}/submissions/recent`);
                        const d = await r.json();
                        if (!d.success) throw new Error();
                        const el = document.getElementById('activity-list');
                        if (!d.data.length) { el.innerHTML = '<p class="msg-empty">No recent submissions.</p>'; return; }
                        el.innerHTML = d.data.map(s => {
                            const vc = s.verdict === 'Accepted' ? 'v-ac' : (s.verdict && s.verdict !== 'Pending' ? 'v-wa' : 'v-ot');
                            const color = s.userColor || 'var(--text-secondary)';
                            return `<div class="activity-row">
                        <a href="/profile/${s.username}" class="a-user" style="color:${color}">${s.username}</a>
                        <a href="/problems/${s.problemSlug}" class="a-prob" title="${s.problemTitle}">${trunc(s.problemTitle, 20)}</a>
                        <div>
                            <span class="a-verdict ${vc}">${s.verdict}</span>
                            <span class="a-lang">${s.language}</span>
                        </div>
                    </div>`;
                        }).join('');
                    } catch {
                        document.getElementById('activity-list').innerHTML = '<p class="msg-err">Failed to load</p>';
                    }
                }

                // Sandbox Modal handlers
                function openSandboxModal() {
                    document.getElementById('sandboxInfoModal').style.display = 'flex';
                }
                function closeSandboxModal() {
                    document.getElementById('sandboxInfoModal').style.display = 'none';
                }

                document.addEventListener('DOMContentLoaded', () => {
                    fetchTopRated();
                    fetchActivities();
                    setInterval(fetchActivities, 15000);

                    // Sandbox Run Sim
                    document.getElementById('runSimBtn').addEventListener('click', () => {
                        const output = document.getElementById('run-output');
                        output.textContent = '▸ Running...';
                        setTimeout(() => { output.textContent = '▸ Output: [0, 1] ✓'; }, 600);
                    });
                });
            </script>
    </body>

    </html>