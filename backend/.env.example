# Port the application runs on (Render sets this dynamically via PORT env variable)
PORT=5000

# MongoDB Connection URI (e.g. MongoDB Atlas Connection URI)
MONGO_URI=mongodb://127.0.0.1:27017/coding-platform

# Secret key for signing JWT authorization tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Google OAuth Credentials for Social Login
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# (Optional callback URL if standard redirect flow is used)
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# (Optional) External Compiler Judge0 Credentials if applicable
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key_here
